# ---------- Google Gemini (Vertex AI) ----------
# Local auth: gcloud auth application-default login   |   Server: service account with the "Vertex AI User" role
GOOGLE_CLOUD_PROJECT=uno-rag-chatbot
GOOGLE_CLOUD_LOCATION=global
# Optional service-account key file (leave empty to use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=
# Fast, cheap model for routing / follow-up rewriting; stronger model for the grounded answer
ROUTER_MODEL=gemini-3.5-flash-lite
ROUTER_THINKING=minimal
ANSWER_MODEL=gemini-3.5-flash
# minimal | low | medium | high
ANSWER_THINKING=low
LLM_TEMPERATURE=0.1
# includes thinking tokens
LLM_MAX_TOKENS=2000
# gemini-embedding-2 embeds one text per request and takes the task as a text prefix
EMBED_MODEL=gemini-embedding-2
EMBED_DIMENSIONS=768
EMBED_QUERY_PREFIX="task: search result | query: "
EMBED_DOC_PREFIX="title: none | text: "
EMBED_CONCURRENCY=8

# ---------- Usage cap / caching ----------
# Safety cap on model requests per UTC day (protects Google Cloud credits)
DAILY_REQUEST_BUDGET=2000
ANSWER_CACHE=true
CACHE_DIR=cache

# ---------- Langfuse monitoring ----------
# Free project at https://cloud.langfuse.com -> Settings -> API Keys. Leave keys empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local
# true on Cloud Run (CPU is throttled after each response, so traces are sent before it ends)
LANGFUSE_FLUSH_EACH_REQUEST=false

# ---------- Paths / Chroma ----------
DATA_DIR=Data
CHROMA_DIR=chroma_db
COLLECTION_NAME=uno_docs_gemini

# ---------- Chunking / retrieval ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
# query rewrites when nothing relevant is found
MAX_REWRITES=1
# number of past chat messages fed to the LLM
HISTORY_WINDOW=6
# hybrid (BM25 + vectors) | bm25 (saves the query-embedding request)
RETRIEVAL_MODE=hybrid

# ---------- API server ----------
API_HOST=0.0.0.0
API_PORT=8000
# Shared secret: WordPress sends it as header X-API-Key (leave empty to disable the check)
BACKEND_API_KEY=change-me-to-a-long-random-string
AUTO_INGEST_ON_STARTUP=true
LOG_LEVEL=INFO
